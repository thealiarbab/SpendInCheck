{
  "version": 2,
  "builds": [
    {
      "src": "app.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": [
          "server/**"
        ]
      }
    },
    {
      "src": "web/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "app.py" },
    { "src": "/assets/(.*)", "dest": "/web/assets/$1" },
    { "src": "/(.+[.][A-Za-z0-9]+)$", "dest": "/web/$1" },
    { "src": "/(.*)", "dest": "/web/index.html" }
  ],
  "crons": [
    {
      "path": "/api/v1/cron/clear-demos",
      "schedule": "0 3 * * *"
    }
  ],
  "regions": [
    "bom1"
  ]
}
