{
  "version": 2,
  "builds": [
    {
      "src": "app.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": [
          "server/**",
          "templates/**",
          "static/**"
        ]
      }
    },
    {
      "src": "web/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/app/assets/(.*)",
      "dest": "/web/assets/$1"
    },
    {
      "src": "/app/([^/]+\\.[a-z0-9]+)",
      "dest": "/web/$1"
    },
    {
      "src": "/app(?:/.*)?",
      "dest": "/web/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "app.py"
    }
  ],
  "crons": [
    {
      "path": "/api/v1/cron/clear-demos",
      "schedule": "0 3 * * *"
    }
  ],
  "regions": [
    "bom1"
  ]
}