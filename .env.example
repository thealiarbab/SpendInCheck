# SpendInCheck environment settings.
# This file is gitignored - it never reaches GitHub.
# Copy it to .env for local development, and paste the same values into
# the Vercel project's Environment Variables page for production.

# --- Postgres (Supabase) ---------------------------------------------------
# Preferred: the single pooled connection string from
#   Supabase > Project Settings > Database > Connection string > Transaction pooler
# It looks like:
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
#
# Use the POOLER host on port 6543, not the direct host on 5432. Every
# serverless request opens its own connection and the direct endpoint runs
# out of connections under load.
DATABASE_URL=

# Alternative to DATABASE_URL, for a local Postgres server.
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_USE_SSL=true

# --- Application -----------------------------------------------------------
# Signs the session cookie. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Changing it signs every user out, so set it once and leave it alone.
SECRET_KEY=

# Guards /api/v1/cron/*. Vercel cron requests are unauthenticated by default,
# so without this the scheduled endpoints refuse to run.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
CRON_SECRET=

# --- StockSaathi integration ------------------------------------------------
# Live quotes and instrument search. The quote API needs no key.
STOCKSAATHI_BASE_URL=https://stocksaathi.co.in

# Encrypts StockSaathi account-link tokens at rest. Leave blank to keep
# optional account linking disabled.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
LINK_ENC_KEY=
