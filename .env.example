# SpendInCheck environment settings.
# This file is gitignored - it never reaches GitHub.
#
# Leave a value BLANK to use the local development default.
# Fill them all in before pasting this file into Vercel.

# --- Aiven MySQL: copy these from the Aiven service overview page ---
# DB_HOST   looks like  mysql-xxxx-yyyy.a.aivencloud.com
# DB_PORT   is NOT 3306 - Aiven assigns its own, e.g. 12345
# DB_USER   is usually  avnadmin
# DB_NAME   is usually  defaultdb
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_USE_SSL=true

# --- App settings ---
# SECRET_KEY is already generated for you.
# APP_PASSWORD is the password you will type to sign in to the site.
# If APP_PASSWORD is left blank the site has NO login.
SECRET_KEY=
APP_PASSWORD=
